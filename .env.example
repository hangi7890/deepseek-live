# Without a key, the application runs explicitly labeled scripted demo responses.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=3000
# REQUIRED when binding to a non-loopback host. Use a long random value.
LIVE_ACCESS_TOKEN=
# Set to the exact public origin when using a reverse proxy (no trailing slash).
PUBLIC_ORIGIN=
